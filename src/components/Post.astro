---
import { dateOf, slugOf } from "../scripts/getPosts";

const { post } = Astro.props;
const { title, description, tags, added, draft } = post.data;
const slug = slugOf(post);
const date = dateOf(added);

// No dev-only guard needed: getPosts() filters drafts out of production
// builds entirely, so this marker can only ever render locally.
---

<li class:list={["post", { "is-draft": draft }]}>
	{draft && <span class="draft-flag">draft</span>}
	<a href={`/post/${slug}/`} class="title">{title}</a>
	<time datetime={date.toISOString()}>
		{
			date.toLocaleDateString("en-us", {
				year: "numeric",
				month: "short",
				day: "numeric",
			})
		}
	</time>
	<br />
	{description && <span class="excerpt">{description}</span>}
	<div>
		{
			tags &&
				tags.map((tag) => (
					<a class="tag" href={`/tag/${tag}`}>
						#{tag}
					</a>
				))
		}
	</div>
</li>
