---
import { dateOf, slugOf } from "../scripts/getPosts";

const { post } = Astro.props;
const { title, description, tags, added } = post.data;
const slug = slugOf(post);
const date = dateOf(added);
---

<li class="post">
	<a href={`/post/${slug}/`} class="title">{title}</a>
	<time datetime={date.toISOString()}>
		{
			date.toLocaleDateString("en-us", {
				year: "numeric",
				month: "short",
				day: "numeric",
			})
		}
	</time>
	<br />
	{description && <span class="excerpt">{description}</span>}
	<div>
		{
			tags &&
				tags.map((tag) => (
					<a class="tag" href={`/tag/${tag}`}>
						#{tag}
					</a>
				))
		}
	</div>
</li>
