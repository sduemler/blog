---
import { Icon } from 'astro-icon/components';

const today = new Date();
---

<footer>
	<div class="footer-links">
		<a href="https://github.com/sduemler" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
			<Icon name="mdi:github" size={20} />
		</a>
		<a href="/rss.xml" aria-label="RSS Feed" target="_blank" rel="noopener noreferrer">
			<Icon name="mdi:rss" size={20} />
		</a>
	</div>
	&copy; {today.getFullYear()} samduemler.
	<br />
	Template used from <a href="https://github.com/cassidoo/blahg">cassidoo</a>
</footer>
<style>
	footer {
		padding: 25px;
		text-align: center;
		font-size: 0.8rem;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		gap: 16px;
		margin-bottom: 12px;
	}
	.footer-links a {
		display: inline-flex;
		align-items: center;
		color: var(--gray);
		transition: color 0.15s ease;
	}
	.footer-links a:hover {
		color: var(--blue);
	}
</style>
