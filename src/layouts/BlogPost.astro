---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ColorScript from "../components/ColorScript.astro";
import Tags from "../components/Tags.astro";
import getPosts, { getTags, dateOf } from "../scripts/getPosts";

const { post } = Astro.props;
const { title, description, added, updated, tags, draft } = post.data;

const allTags = getTags(getPosts(await getCollection("posts")));

const fmt = (value) =>
	dateOf(value).toLocaleDateString("en-us", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});

const addedLabel = fmt(added);
const updatedLabel = updated ? fmt(updated) : null;
---

<html lang="en-us">
	<BaseHead title={title} description={description} />

	<body>
		<Header />
		<main>
			<article>
				{draft && <p class="draft-banner">Draft &mdash; only visible locally, not published.</p>}
				<h1 class="article-title">{title}</h1>
				{updatedLabel ?
					<span><time>{addedLabel}</time>, last updated on <time>{updatedLabel}</time></span>
					:
					<span><time>{addedLabel}</time></span>
				}
				<Tags tags={tags} />
				<hr />
				<div class="blog-post">
					<slot />
				</div>
			</article>
		</main>
		<Tags tags={allTags} all />
		<Footer />
		<ColorScript />
	</body>
</html>
