---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import getPosts, { slugOf } from "../../scripts/getPosts";

export async function getStaticPaths() {
	// getPosts() drops drafts, so no page is built for them at all. Filtering
	// only the listings would leave a draft live at its own URL.
	const posts = getPosts(await getCollection("posts"));

	return posts.map((post) => ({
		params: { slug: slugOf(post) },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogPost post={post}>
	<Content />
</BlogPost>
